{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "printopia",
  "compatibility_date": "2025-05-01",
  "main": "src/worker.ts",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "printopia",
      "database_id": "شناسه-واقعی-دیتابیس-خودت"
    }
  ]
}
