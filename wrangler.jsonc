{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "printopia",
  "compatibility_date": "2025-05-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /media/* must reach the Worker (it streams objects out of R2), otherwise
    // the SPA fallback would answer image requests with index.html.
    "run_worker_first": ["/api/*", "/media/*"]
  }

  ,
  // ---------------------------------------------------------------------------
  // D1 database binding — provides zero-latency CMS access.
  //
  // IMPORTANT: This Worker also reaches D1 over the REST API when this binding
  // is absent, so the CMS works immediately after provisioning with no repo
  // edit and transparently upgrades to this faster path once you paste
  // database_id here and redeploy.
  //
  // To make access permanently fastest:
  //   1) Complete the Cloudflare setup in /admin/setup
  //   2) Copy the database_id shown at the end
  //   3) Paste it here (replacing the placeholder)
  //   4) Commit and push
  // ---------------------------------------------------------------------------
  "d1_databases": [
    { "binding": "DB", "database_name": "printopia-cms", "database_id": "paste-your-database-id-here" }
  ],

  // ---------------------------------------------------------------------------
  // R2 bucket binding — durable, shared storage for every uploaded image.
  //
  // Unlike D1 there is no id to paste: the bucket name is enough, and setup
  // creates the bucket automatically. This binding is the fast path; when it is
  // missing the Worker falls back to the R2 REST API using the CF_API_TOKEN
  // secret, so uploads keep working even before this takes effect.
  //
  // Images are served by the Worker at /media/<key>, so the bucket stays
  // private and NO manual Cloudflare dashboard step is needed.
  // ---------------------------------------------------------------------------
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "printopia-media" }
  ]
}

