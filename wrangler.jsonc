{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "printopia",
  "compatibility_date": "2025-05-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
  ,
  // ---------------------------------------------------------------------------
  // D1 database binding — provides zero-latency CMS access.
  //
  // IMPORTANT: This Worker also reaches D1 over the REST API when this binding
  // is absent, so the CMS works immediately after provisioning with no repo
  // edit and transparently upgrades to this faster path once you paste
  // database_id here and redeploy.
  //
  // To make access permanently fastest:
  //   1) Complete the Cloudflare setup in /admin/setup
  //   2) Copy the database_id shown at the end
  //   3) Paste it here (replacing the placeholder)
  //   4) Commit and push
  // ---------------------------------------------------------------------------
  "d1_databases": [
    { "binding": "DB", "database_name": "printopia-cms", "database_id": "paste-your-database-id-here" }
  ]
}
